# Website assistant (src/app/api/chat/route.ts)
# Create a free key at https://console.groq.com/keys and put it in .env.local
# (or your VPS process manager's environment). Never commit the real key.
GROQ_API_KEY=

# Optional: override the Groq model. Default: openai/gpt-oss-120b
# CHAT_MODEL=openai/gpt-oss-120b

# Public address of the site, e.g. https://rafeeq.example (no trailing slash).
# Needed at build time for canonical links, hreflang alternates and the
# sitemap. Leave unset until the real domain exists.
# SITE_URL=
